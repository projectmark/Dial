<UserControl
    x:Class="Dial.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        x:Name="HomeScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        ViewChanged="HomeScrollViewer_ViewChanged">
        <Grid x:Name="ScrollContentRoot" Padding="24">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="16">

                <!-- Zone 1: Now Playing Hero Card (scrolls naturally out of view) -->
                <Border
                    x:Name="HeroCard"
                    CornerRadius="8"
                    BorderThickness="1"
                    Padding="24,20"
                    SizeChanged="StickyLayoutAnchor_SizeChanged">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="HeroIconBox"
                                Grid.Column="0"
                                Width="52"
                                Height="52"
                                CornerRadius="8"
                                BorderThickness="1"
                                VerticalAlignment="Top">
                                <FontIcon
                                    x:Name="HeroIconGlyph"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="24"
                                    Glyph="&#xE7F6;"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="HeroStationTitle"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />

                                    <Border
                                        x:Name="StatusBadge"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        Padding="10,2"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse
                                                x:Name="StatusDot"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                x:Name="StatusBadgeText"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        x:Name="PreviewBadge"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            x:Name="PreviewBadgeText"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="HeroNowPlayingText"
                                        Grid.Column="0"
                                        FontSize="14"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                    <Button
                                        x:Name="OpenTrackLookupBtn"
                                        Grid.Column="1"
                                        Height="26"
                                        Padding="10,2"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Click="OpenTrackLookupBtn_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE8A7;" />
                                            <TextBlock x:Name="OpenTrackLookupLabel" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="HeroMetaText"
                                        FontSize="12"
                                        VerticalAlignment="Center" />

                                    <Border
                                        x:Name="SleepStatusPill"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        Padding="8,2"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon
                                                x:Name="SleepStatusIcon"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="11"
                                                Glyph="&#xE823;" />
                                            <TextBlock
                                                x:Name="SleepStatusText"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center" />
                                            <Button
                                                x:Name="SleepCancelInlineBtn"
                                                Width="18"
                                                Height="18"
                                                Padding="0"
                                                CornerRadius="9"
                                                BorderThickness="0"
                                                Click="SleepCancelInlineBtn_Click">
                                                <FontIcon
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="9"
                                                    Glyph="&#xE711;" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Transport, Volume & Quick Action Controls -->
                        <Grid x:Name="TransportBarGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel
                                x:Name="PlaybackButtonsPanel"
                                Grid.Row="0"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="PrevStationBtn"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="6"
                                    Click="PrevStationBtn_Click">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE892;" />
                                </Button>

                                <Button
                                    x:Name="PlayPauseBtn"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="20"
                                    Click="PlayPauseBtn_Click">
                                    <FontIcon
                                        x:Name="PlayPauseGlyph"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="16"
                                        Glyph="&#xE768;" />
                                </Button>

                                <Button
                                    x:Name="NextStationBtn"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="6"
                                    Click="NextStationBtn_Click">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE893;" />
                                </Button>
                            </StackPanel>

                            <StackPanel
                                x:Name="VolumePanel"
                                Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                                <Button
                                    x:Name="MuteBtn"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="6"
                                    Click="MuteBtn_Click">
                                    <FontIcon
                                        x:Name="MuteGlyph"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="15"
                                        Glyph="&#xE767;" />
                                </Button>

                                <Slider
                                    x:Name="VolumeSlider"
                                    Width="120"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="1"
                                    SmallChange="1"
                                    LargeChange="10"
                                    IsThumbToolTipEnabled="False"
                                    VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged" />

                                <TextBlock
                                    x:Name="VolumeValueText"
                                    Width="36"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel
                                x:Name="QuickToolsPanel"
                                Grid.Row="0"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="SleepTimerBtn"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE823;" />
                                    <Button.Flyout>
                                        <Flyout x:Name="SleepTimerFlyout" Opening="SleepTimerFlyout_Opening">
                                            <StackPanel Spacing="10" Width="240" Padding="4">
                                                <TextBlock
                                                    x:Name="SleepFlyoutHeading"
                                                    FontSize="14"
                                                    FontWeight="SemiBold" />
                                                <Grid x:Name="SleepPresetsGrid" ColumnSpacing="8" RowSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        x:Name="SleepCustomBox"
                                                        Grid.Column="0"
                                                        InputScope="Number" />
                                                    <Button
                                                        x:Name="SleepCustomStartBtn"
                                                        Grid.Column="1"
                                                        Height="32"
                                                        Padding="12,4"
                                                        CornerRadius="6"
                                                        Click="SleepCustomStartBtn_Click" />
                                                </Grid>
                                                <Button
                                                    x:Name="SleepFlyoutCancelBtn"
                                                    HorizontalAlignment="Stretch"
                                                    Height="32"
                                                    CornerRadius="6"
                                                    Visibility="Collapsed"
                                                    Click="SleepFlyoutCancelBtn_Click" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <Button
                                    x:Name="StatsBtn"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE9D9;" />
                                    <Button.Flyout>
                                        <Flyout x:Name="StatsFlyout" Opening="StatsFlyout_Opening">
                                            <StackPanel Spacing="10" Width="280" Padding="4">
                                                <TextBlock
                                                    x:Name="StatsFlyoutHeading"
                                                    FontSize="14"
                                                    FontWeight="SemiBold" />
                                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel x:Name="StatsListPanel" Spacing="6" />
                                                </ScrollViewer>
                                                <TextBlock
                                                    x:Name="StatsTotalText"
                                                    FontSize="12"
                                                    FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <Button
                                    x:Name="MiniPlayerBtn"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="6"
                                    Click="MiniPlayerBtn_Click">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE944;" />
                                </Button>

                                <Button
                                    x:Name="MinimizeTrayBtn"
                                    Height="36"
                                    Padding="10,6"
                                    CornerRadius="6"
                                    Click="MinimizeTrayBtn_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE921;" />
                                        <TextBlock
                                            x:Name="MinimizeTrayLabel"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Zone 2: Favorites Header + Sticky Edit Toolbar + Scrollable List -->
                <StackPanel Spacing="10">
                    <Grid
                        x:Name="FavoritesHeaderGrid"
                        ColumnSpacing="12"
                        SizeChanged="StickyLayoutAnchor_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="StationsHeading"
                            Grid.Column="0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />

                        <Button
                            x:Name="EditModeBtn"
                            Grid.Column="1"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="6"
                            VerticalAlignment="Center"
                            Click="EditModeBtn_Click">
                            <FontIcon
                                x:Name="EditModeGlyph"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE70F;" />
                        </Button>
                    </Grid>

                    <!-- Sticky Edit Mode Toolbar -->
                    <Grid
                        x:Name="EditToolbarAnchor"
                        Canvas.ZIndex="10">
                        <Border
                            x:Name="EditToolbar"
                            CornerRadius="8"
                            BorderThickness="1"
                            Padding="16,12"
                            Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="StickyEditTransform" Y="0" />
                            </Border.RenderTransform>
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="AddCustomBtn"
                                            Height="34"
                                            Padding="12,6"
                                            CornerRadius="6"
                                            Click="AddCustomBtn_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE710;" />
                                                <TextBlock x:Name="AddCustomLabel" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            x:Name="ExportBtn"
                                            Height="34"
                                            Padding="12,6"
                                            CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xEDE1;" />
                                                <TextBlock x:Name="ExportLabel" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Name="ExportCodeMenuItem" Click="ExportCodeMenuItem_Click" />
                                                    <MenuFlyoutItem x:Name="ExportFileMenuItem" Click="ExportFileMenuItem_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>

                                        <Button
                                            x:Name="ImportBtn"
                                            Height="34"
                                            Padding="12,6"
                                            CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8B5;" />
                                                <TextBlock x:Name="ImportLabel" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Name="ImportRadiOhFileMenuItem" Click="ImportRadiOhFileMenuItem_Click" />
                                                    <MenuFlyoutItem x:Name="ImportFileMenuItem" Click="ImportFileMenuItem_Click" />
                                                    <MenuFlyoutItem x:Name="ImportCodeMenuItem" Click="ImportCodeMenuItem_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>

                                    <Button
                                        x:Name="DoneEditingBtn"
                                        Grid.Column="1"
                                        Height="34"
                                        Padding="12,6"
                                        CornerRadius="6"
                                        Click="EditModeBtn_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE73E;" />
                                            <TextBlock x:Name="DoneEditingLabel" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid ColumnSpacing="10" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        x:Name="SelectAllCheckBox"
                                        Grid.Column="0"
                                        IsThreeState="True"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        Click="SelectAllCheckBox_Click" />

                                    <TextBlock
                                        x:Name="SelectionHintText"
                                        Grid.Column="1"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />

                                    <Button
                                        x:Name="BulkDeleteBtn"
                                        Grid.Column="2"
                                        Height="32"
                                        Padding="12,4"
                                        CornerRadius="6"
                                        IsEnabled="False"
                                        Click="BulkDeleteBtn_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE74D;" />
                                            <TextBlock x:Name="BulkDeleteLabel" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock
                                    x:Name="EditStatusText"
                                    FontSize="12"
                                    Visibility="Collapsed"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel
                        x:Name="StationsListPanel"
                        Spacing="6" />

                    <Grid
                        x:Name="StationsGrid"
                        ColumnSpacing="12"
                        RowSpacing="12"
                        Visibility="Collapsed" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
