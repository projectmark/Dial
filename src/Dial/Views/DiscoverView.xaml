<UserControl
    x:Class="Dial.Views.DiscoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid MaxWidth="1000" HorizontalAlignment="Stretch" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Name="HeaderTitle" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderSubtitle" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Search, Quality & Country Filter Bar -->
            <Grid
                x:Name="SearchBarGrid"
                Grid.Row="1"
                ColumnSpacing="10"
                RowSpacing="10"
                SizeChanged="SearchBarGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Row="0"
                    Grid.Column="0"
                    KeyDown="SearchBox_KeyDown" />

                <Button
                    x:Name="SearchBtn"
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="36"
                    Padding="14,6"
                    CornerRadius="6"
                    Click="SearchBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE721;" />
                        <TextBlock x:Name="SearchBtnLabel" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <StackPanel
                    x:Name="FilterControlsPanel"
                    Grid.Row="0"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="10">
                    <ComboBox
                        x:Name="MinBitrateCombo"
                        Height="36"
                        MinWidth="156"
                        CornerRadius="6"
                        SelectionChanged="MinBitrateCombo_SelectionChanged">
                        <ComboBoxItem x:Name="BitrateAllItem" Tag="0" />
                        <ComboBoxItem x:Name="Bitrate64Item" Tag="64" />
                        <ComboBoxItem x:Name="Bitrate96Item" Tag="96" />
                        <ComboBoxItem x:Name="Bitrate128Item" Tag="128" />
                        <ComboBoxItem x:Name="Bitrate192Item" Tag="192" />
                        <ComboBoxItem x:Name="Bitrate256Item" Tag="256" />
                        <ComboBoxItem x:Name="Bitrate320Item" Tag="320" />
                    </ComboBox>

                    <Button
                        x:Name="CountryFilterBtn"
                        Height="36"
                        Padding="14,6"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE774;" />
                            <TextBlock x:Name="CountryFilterLabel" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="CountryFlyout" Opening="CountryFlyout_Opening">
                                <StackPanel Spacing="10" Width="320" Padding="4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="CountryQuickNlBtn"
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            Height="32"
                                            CornerRadius="6"
                                            Click="CountryQuickNlBtn_Click" />
                                        <Button
                                            x:Name="CountryResetBtn"
                                            Grid.Column="1"
                                            Height="32"
                                            Padding="12,4"
                                            CornerRadius="6"
                                            Click="CountryResetBtn_Click" />
                                    </Grid>

                                    <Grid x:Name="AlphabetGrid" ColumnSpacing="4" RowSpacing="4" />

                                    <ProgressRing
                                        x:Name="CountryLoadingRing"
                                        Width="20"
                                        Height="20"
                                        IsActive="False"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center" />

                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="CountryListPanel" Spacing="4" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Line -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="18"
                    Height="18"
                    IsActive="False"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="StatusText"
                    FontSize="12"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Results List -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultsListPanel" Spacing="8" Padding="0,0,4,12" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
