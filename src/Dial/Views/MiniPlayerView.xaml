<UserControl
    x:Class="Dial.Views.MiniPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="12,4,12,12">
        <Border
            x:Name="MiniCard"
            CornerRadius="8"
            BorderThickness="1"
            Padding="14,10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Station + Pin & Expand -->
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse
                        x:Name="StatusDot"
                        Grid.Column="0"
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center" />

                    <TextBlock
                        x:Name="StationTitle"
                        Grid.Column="1"
                        FontSize="15"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button
                            x:Name="PinBtn"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="6"
                            Click="PinBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE718;" />
                        </Button>
                        <Button
                            x:Name="ExpandBtn"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="6"
                            Click="ExpandBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE740;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Track / Tagline -->
                <TextBlock
                    x:Name="NowPlayingText"
                    Grid.Row="1"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis" />

                <!-- Transport & Sleep Readout -->
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button
                            x:Name="PrevBtn"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="6"
                            Click="PrevBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE892;" />
                        </Button>
                        <Button
                            x:Name="PlayPauseBtn"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="17"
                            Click="PlayPauseBtn_Click">
                            <FontIcon
                                x:Name="PlayPauseGlyph"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE768;" />
                        </Button>
                        <Button
                            x:Name="NextBtn"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="6"
                            Click="NextBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE893;" />
                        </Button>
                        <Button
                            x:Name="MuteBtn"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="6"
                            Click="MuteBtn_Click">
                            <FontIcon
                                x:Name="MuteGlyph"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="13"
                                Glyph="&#xE767;" />
                        </Button>
                    </StackPanel>

                    <StackPanel
                        x:Name="SleepIndicator"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="SleepIcon"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="11"
                            Glyph="&#xE823;" />
                        <TextBlock
                            x:Name="SleepText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
