<UserControl
    x:Class="Dial.Views.MiniPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="12,4,12,12">
        <Border
            x:Name="MiniCard"
            CornerRadius="8"
            BorderThickness="1"
            Padding="14,12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Station + ON AIR Status Badge + Sleep Timer + Pin & Expand -->
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" HorizontalAlignment="Left" ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="StationTitle"
                            Grid.Column="0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Border
                                x:Name="StatusBadgeGlow"
                                CornerRadius="14"
                                Margin="-12,-6"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="StatusBadge"
                                CornerRadius="10"
                                BorderThickness="1"
                                Padding="8,2"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Grid Width="10" Height="10" VerticalAlignment="Center">
                                        <Ellipse
                                            x:Name="StatusDotHalo"
                                            Width="10"
                                            Height="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed" />
                                        <Ellipse
                                            x:Name="StatusDot"
                                            Width="6"
                                            Height="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="StatusBadgeText"
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <StackPanel
                        x:Name="SleepIndicator"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="SleepIcon"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="11"
                            Glyph="&#xE823;" />
                        <TextBlock
                            x:Name="SleepText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button
                            x:Name="PinBtn"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="6"
                            Click="PinBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE718;" />
                        </Button>
                        <Button
                            x:Name="ExpandBtn"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="6"
                            Click="ExpandBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE740;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Track / Tagline -->
                <Grid Grid.Row="1" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="NowPlayingText"
                        Grid.Column="0"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="OpenTrackLookupBtn"
                        Grid.Column="1"
                        Width="24"
                        Height="24"
                        Padding="0"
                        CornerRadius="6"
                        Visibility="Collapsed"
                        Click="OpenTrackLookupBtn_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE8A7;" />
                    </Button>
                </Grid>

                <!-- Row 2: Full-Width Transport & Volume Controls -->
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="PrevBtn"
                        Grid.Column="0"
                        Width="38"
                        Height="36"
                        Padding="0"
                        CornerRadius="6"
                        Click="PrevBtn_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE892;" />
                    </Button>

                    <Button
                        x:Name="PlayPauseBtn"
                        Grid.Column="1"
                        Width="54"
                        Height="36"
                        Padding="0"
                        CornerRadius="18"
                        Click="PlayPauseBtn_Click">
                        <FontIcon
                            x:Name="PlayPauseGlyph"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="15"
                            Glyph="&#xE768;" />
                    </Button>

                    <Button
                        x:Name="NextBtn"
                        Grid.Column="2"
                        Width="38"
                        Height="36"
                        Padding="0"
                        CornerRadius="6"
                        Click="NextBtn_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE893;" />
                    </Button>

                    <Button
                        x:Name="MuteBtn"
                        Grid.Column="3"
                        Width="36"
                        Height="36"
                        Padding="0"
                        CornerRadius="6"
                        Click="MuteBtn_Click">
                        <FontIcon
                            x:Name="MuteGlyph"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE767;" />
                    </Button>

                    <Slider
                        x:Name="VolumeSlider"
                        Grid.Column="4"
                        HorizontalAlignment="Stretch"
                        Minimum="0"
                        Maximum="100"
                        StepFrequency="1"
                        SmallChange="1"
                        LargeChange="10"
                        IsThumbToolTipEnabled="False"
                        VerticalAlignment="Center"
                        ValueChanged="VolumeSlider_ValueChanged" />

                    <TextBlock
                        x:Name="VolumeValueText"
                        Grid.Column="5"
                        FontSize="11"
                        FontWeight="SemiBold"
                        TextAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- Row 3: Subtle Stereo L/R VU Meter -->
                <Grid Grid.Row="3" RowSpacing="4" Margin="0,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="12" />
                        <RowDefinition Height="12" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="LeftVuLabel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="L"
                        FontSize="9"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />

                    <Border
                        x:Name="LeftVuTrack"
                        Grid.Row="0"
                        Grid.Column="1"
                        Height="5"
                        CornerRadius="2.5"
                        VerticalAlignment="Center">
                        <Border
                            x:Name="LeftVuFill"
                            Height="5"
                            CornerRadius="2.5"
                            HorizontalAlignment="Stretch"
                            Opacity="0.88"
                            RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LeftVuScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>

                    <TextBlock
                        x:Name="RightVuLabel"
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="R"
                        FontSize="9"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />

                    <Border
                        x:Name="RightVuTrack"
                        Grid.Row="1"
                        Grid.Column="1"
                        Height="5"
                        CornerRadius="2.5"
                        VerticalAlignment="Center">
                        <Border
                            x:Name="RightVuFill"
                            Height="5"
                            CornerRadius="2.5"
                            HorizontalAlignment="Stretch"
                            Opacity="0.88"
                            RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RightVuScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
