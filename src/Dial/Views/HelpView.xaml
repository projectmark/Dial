<UserControl
    x:Class="Dial.Views.HelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid MaxWidth="1000" HorizontalAlignment="Stretch" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="HeaderTitle" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSubtitle" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="DocsModeBtn" Height="34" Padding="14,6" CornerRadius="17" Click="DocsModeBtn_Click" />
                    <Button x:Name="ChangelogModeBtn" Height="34" Padding="14,6" CornerRadius="17" Click="ChangelogModeBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="ChangelogModeLabel" VerticalAlignment="Center" />
                            <Ellipse
                                x:Name="ChangelogUnreadDot"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="DocsFilterBar" Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    TextChanged="SearchBox_TextChanged" />

                <ComboBox
                    x:Name="CategoryCombo"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="CategoryCombo_SelectionChanged" />
            </Grid>

            <!-- Docs Split View with two independent ScrollViewers -->
            <Grid x:Name="DocsSplitGrid" Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DocsLeftCol" Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ArticleListPanel" Spacing="8" Padding="0,0,4,0" />
                </ScrollViewer>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Border x:Name="DetailCard" CornerRadius="8" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="DetailCategoryPill" CornerRadius="10" BorderThickness="1" Padding="10,3">
                                    <TextBlock x:Name="DetailCategoryText" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="DetailBadgePill" CornerRadius="10" BorderThickness="1" Padding="10,3" Visibility="Collapsed">
                                    <TextBlock x:Name="DetailBadgeText" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailSummary" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailBody" FontSize="14" TextWrapping="Wrap" LineHeight="22" />

                            <Border x:Name="CopyRefContainer" CornerRadius="6" BorderThickness="1" Padding="12" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="CopyRefText"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                    <Button
                                        x:Name="CopyRefButton"
                                        Grid.Column="1"
                                        Height="32"
                                        Padding="12,4"
                                        CornerRadius="6"
                                        Click="CopyRefButton_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- Changelog Timeline View -->
            <ScrollViewer x:Name="ChangelogScroll" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChangelogPanel" Spacing="16" Padding="0,0,4,16" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
