<Application
    x:Class="Dial.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#28FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackground" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C8FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5DFFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C8FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF99A4" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#28FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackground" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C8FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5DFFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C8FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF99A4" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#C8FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="ButtonBackground" Color="#F4FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EAEAEA" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DADADA" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#70F4F4F4" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#1A000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#1A000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#1A000000" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#E4000000" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E4000000" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#96000000" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5C000000" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#96000000" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C000000" />
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
