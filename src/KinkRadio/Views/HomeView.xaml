<UserControl
    x:Class="KinkRadio.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="24">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="20">

                <!-- Zone 1: Now Playing Hero Card -->
                <Border
                    x:Name="HeroCard"
                    CornerRadius="8"
                    BorderThickness="1"
                    Padding="24,20">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="HeroIconBox"
                                Grid.Column="0"
                                Width="52"
                                Height="52"
                                CornerRadius="8"
                                BorderThickness="1"
                                VerticalAlignment="Top">
                                <FontIcon
                                    x:Name="HeroIconGlyph"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="24"
                                    Glyph="&#xE7F6;"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="HeroStationTitle"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />

                                    <Border
                                        x:Name="StatusBadge"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        Padding="10,2"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse
                                                x:Name="StatusDot"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                x:Name="StatusBadgeText"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    x:Name="HeroNowPlayingText"
                                    FontSize="14"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    x:Name="HeroMetaText"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- Transport & Volume Controls -->
                        <Grid x:Name="TransportBarGrid" ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel
                                x:Name="PlaybackButtonsPanel"
                                Grid.Row="0"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="PrevStationBtn"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="6"
                                    Click="PrevStationBtn_Click">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE892;" />
                                </Button>

                                <Button
                                    x:Name="PlayPauseBtn"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="20"
                                    Click="PlayPauseBtn_Click">
                                    <FontIcon
                                        x:Name="PlayPauseGlyph"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="16"
                                        Glyph="&#xE768;" />
                                </Button>

                                <Button
                                    x:Name="NextStationBtn"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="6"
                                    Click="NextStationBtn_Click">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE893;" />
                                </Button>
                            </StackPanel>

                            <StackPanel
                                x:Name="VolumePanel"
                                Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                                <Button
                                    x:Name="MuteBtn"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="6"
                                    Click="MuteBtn_Click">
                                    <FontIcon
                                        x:Name="MuteGlyph"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="15"
                                        Glyph="&#xE767;" />
                                </Button>

                                <Slider
                                    x:Name="VolumeSlider"
                                    Width="136"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="2"
                                    SmallChange="2"
                                    LargeChange="10"
                                    VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged" />

                                <TextBlock
                                    x:Name="VolumeValueText"
                                    Width="38"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <Button
                                x:Name="MinimizeTrayBtn"
                                Grid.Row="0"
                                Grid.Column="2"
                                Height="36"
                                Padding="12,6"
                                CornerRadius="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="MinimizeTrayBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE921;" />
                                    <TextBlock
                                        x:Name="MinimizeTrayLabel"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Zone 2: 2x2 KINK Station Grid -->
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="StationsHeading"
                        FontSize="15"
                        FontWeight="SemiBold" />

                    <Grid
                        x:Name="StationsGrid"
                        ColumnSpacing="12"
                        RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
