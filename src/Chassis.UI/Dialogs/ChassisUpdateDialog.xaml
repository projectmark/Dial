<ContentDialog
    x:Class="Chassis.UI.Dialogs.ChassisUpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CloseButtonClick="ContentDialog_CloseButtonClick">

    <StackPanel Spacing="12" MinWidth="420" MaxWidth="460" Padding="0,4,0,0">
        <TextBlock x:Name="SubtitleBlock" FontSize="13" TextWrapping="Wrap" />

        <Border
            x:Name="VersionCard"
            CornerRadius="8"
            BorderThickness="1"
            Padding="14,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="VersionHeadline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionDetail" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    x:Name="ReleaseNotesBtn"
                    Grid.Column="1"
                    Height="30"
                    Padding="10,4"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="ReleaseNotesBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE8A7;" />
                        <TextBlock x:Name="ReleaseNotesLabel" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <StackPanel x:Name="ProgressPanel" Spacing="6" Visibility="Collapsed">
            <ProgressBar
                x:Name="DownloadProgressBar"
                Minimum="0"
                Maximum="100"
                Value="0" />
            <TextBlock
                x:Name="ProgressStatusText"
                FontSize="12"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            x:Name="NoticeBlock"
            FontSize="12"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
