<ContentDialog
    x:Class="Chassis.UI.Dialogs.ChassisFeedbackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="12" MinWidth="420" Padding="0,4,0,0">
        <TextBlock x:Name="SubtitleBlock" FontSize="13" TextWrapping="Wrap" />

        <StackPanel Spacing="4">
            <TextBlock x:Name="CategoryLabelBlock" FontSize="12" FontWeight="SemiBold" />
            <ComboBox x:Name="CategoryCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem x:Name="CatGeneralItem" Tag="General" />
                <ComboBoxItem x:Name="CatBugItem" Tag="Bug" />
                <ComboBoxItem x:Name="CatFeatureItem" Tag="Feature" />
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="SubjectLabelBlock" FontSize="12" FontWeight="SemiBold" />
            <TextBox x:Name="SubjectBox" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="DescriptionLabelBlock" FontSize="12" FontWeight="SemiBold" />
            <TextBox
                x:Name="DescriptionBox"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="100"
                MaxHeight="180" />
        </StackPanel>

        <CheckBox x:Name="DiagnosticsCheckBox" IsChecked="True" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="AttachButton"
                Height="32"
                Padding="12,0"
                CornerRadius="6"
                Click="AttachButton_Click" />
            <TextBlock
                x:Name="AttachmentNameBlock"
                FontSize="12"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBlock
            x:Name="ValidationBlock"
            FontSize="12"
            Visibility="Collapsed"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
