<UserControl
    x:Class="Chassis.UI.Controls.ChassisTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="40">

    <Grid x:Name="RootGrid" Background="Transparent" Padding="12,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <StackPanel
            x:Name="LeftCluster"
            Grid.Column="0"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="0">
            <StackPanel
                x:Name="BrandGroup"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8"
                Background="Transparent"
                Tapped="BrandGroup_Tapped">
                <Border
                    x:Name="LogoBadge"
                    Width="22"
                    Height="22"
                    CornerRadius="6"
                    BorderThickness="1">
                    <Grid>
                        <FontIcon
                            x:Name="LogoGlyph"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE8F1;"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <Image
                            x:Name="LogoImage"
                            Width="22"
                            Height="22"
                            Stretch="UniformToFill"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

                <TextBlock
                    x:Name="TitleBlock"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>

            <Border
                x:Name="SubtitleHost"
                Padding="8,0,0,0"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="SubtitleBlock"
                    FontSize="12"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="SubtitleTranslate" X="0" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Border>

            <Button
                x:Name="VersionBadgeButton"
                Height="24"
                Margin="8,0,0,0"
                Padding="10,0"
                CornerRadius="12"
                Click="VersionBadgeButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="VersionStatusDot" Width="6" Height="6" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="VersionBadgeText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid
            x:Name="DragRegion"
            Grid.Column="1"
            Background="Transparent"
            Padding="10,0,8,0">
            <StackPanel
                x:Name="LiveStatusPanel"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Ellipse
                    x:Name="LiveStatusDot"
                    Width="6"
                    Height="6"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="LiveStatusText"
                    FontSize="12"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel
            x:Name="RightCluster"
            Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="6"
            Margin="8,0,0,0">
            <Border
                x:Name="FeedbackTooltipHost"
                Background="Transparent"
                CornerRadius="6">
                <Button
                    x:Name="FeedbackButton"
                    Height="28"
                    Padding="8,0"
                    CornerRadius="6"
                    Click="FeedbackButton_Click">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xED15;"
                        FontSize="14" />
                </Button>
            </Border>

            <Button
                x:Name="HelpButton"
                Height="28"
                Padding="8,0"
                CornerRadius="6"
                Click="HelpButton_Click">
                <Grid>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE897;"
                        FontSize="14" />
                    <Ellipse
                        x:Name="HelpUnreadDot"
                        Width="6"
                        Height="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-2,-3,0"
                        Visibility="Collapsed" />
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
