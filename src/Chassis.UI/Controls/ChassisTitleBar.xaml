<UserControl
    x:Class="Chassis.UI.Controls.ChassisTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="40">

    <Grid x:Name="RootGrid" Background="Transparent" Padding="12,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <StackPanel
            x:Name="LeftCluster"
            Grid.Column="0"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="8">
            <Border
                x:Name="LogoBadge"
                Width="22"
                Height="22"
                CornerRadius="6"
                BorderThickness="1">
                <Grid>
                    <FontIcon
                        x:Name="LogoGlyph"
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE8F1;"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <Image
                        x:Name="LogoImage"
                        Width="22"
                        Height="22"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <TextBlock
                x:Name="TitleBlock"
                FontSize="13"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

            <Button
                x:Name="VersionBadgeButton"
                Height="24"
                Padding="10,0"
                CornerRadius="12"
                Click="VersionBadgeButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="VersionStatusDot" Width="6" Height="6" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="VersionBadgeText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border
            x:Name="DragRegion"
            Grid.Column="1"
            Background="Transparent" />

        <StackPanel
            x:Name="RightCluster"
            Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="6"
            Margin="8,0,0,0">
            <Button
                x:Name="FeedbackButton"
                Height="28"
                Padding="8,0"
                CornerRadius="6"
                Click="FeedbackButton_Click">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xED15;"
                    FontSize="14" />
            </Button>

            <Button
                x:Name="HelpButton"
                Height="28"
                Padding="8,0"
                CornerRadius="6"
                Click="HelpButton_Click">
                <Grid>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE897;"
                        FontSize="14" />
                    <Ellipse
                        x:Name="HelpUnreadDot"
                        Width="6"
                        Height="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-2,-3,0"
                        Visibility="Collapsed" />
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
